# Use any of these. Claude wins if set; otherwise Groq, with Gemini as its backup.
# Fast and free: https://console.groq.com/keys
GROQ_API_KEY=
# Free: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Paid: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Set on the hosted server only: the app must send the same value (EXPO_PUBLIC_APP_KEY).
APP_KEY=
# AI requests allowed per address per 10 minutes.
RATE_LIMIT=40

# Most AI calls per day across all users (protects your bill). Default 5000.
DAILY_LIMIT=5000

# Signs each install's pass (any long random string). Required in production.
TOKEN_SECRET=
# RevenueCat secret API key (starts with sk_), so the server can confirm Pro.
# Secret: only here and in your host's settings, never in the app.
REVENUECAT_SECRET_KEY=
# Requests per 10 min per network address (many phones can share one). Default 300.
IP_RATE_LIMIT=300
